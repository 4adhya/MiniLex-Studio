# MiniLex token specification
SKIP WHITESPACE [ \t\r\n]+
SKIP LINE_COMMENT //.*
TOKEN NUMBER [0-9]+(\.[0-9]+)?
TOKEN KEYWORD (int|float|char|double|void|if|else|while|for|return|break|continue)
TOKEN IDENTIFIER [A-Za-z_][A-Za-z0-9_]*
TOKEN PLUS \+
TOKEN MINUS -
TOKEN MULTIPLY \*
TOKEN DIVIDE /
TOKEN ASSIGN =
TOKEN EQUAL ==
TOKEN NOT_EQUAL !=
TOKEN LESS_EQUAL <=
TOKEN GREATER_EQUAL >=
TOKEN LESS <
TOKEN GREATER >
TOKEN LPAREN \(
TOKEN RPAREN \)
TOKEN LBRACE \{
TOKEN RBRACE \}
TOKEN SEMICOLON ;
TOKEN COMMA ,
